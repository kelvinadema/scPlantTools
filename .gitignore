# === Python / environment ===
__pycache__/
*.pyc
*.pyo
*.pyd
.env/
venv/
.envrc
.venv/
*.egg-info/

# === IDE / OS cruft ===
# .vscode/settings.json IS tracked on purpose -- it carries the YAML schema
# associations for configs/schemas/ (see CLAUDE.md's "Editor support"). Only
# per-user / machine-local files are excluded here.
/.claude/
.idea/
.DS_Store
Thumbs.db
*.swp
.pytest_cache/

# === Jupyter ===
.ipynb_checkpoints/
*.nbconvert.ipynb

# === Local working notes and study-specific jobs ===
/CLAUDE.md
/docs/*
!/docs/README.md
!/docs/setup-mapping.md
!/docs/setup-integration.md
!/docs/setup-annotation.md
!/docs/configuration.md
!/docs/outputs.md
!/docs/testing.md
!/docs/releasing.md
!/docs/third-party.md
!/docs/markerid-porting.md
!/docs/decisions/
/batch_scripts/*
!/batch_scripts/README.md
!/batch_scripts/lib/
!/batch_scripts/run_mapper.sh
!/batch_scripts/run_refilter.sh
!/batch_scripts/run_integration.sh
!/batch_scripts/run_annotation.sh
/configs/local/
# Interrupted fetches are local work, never sample-sheet examples.
*.partial

# === One-off maintenance artifacts ===
# Snapshot and cleanup bookkeeping from the 2026-07/08 tree reorganisation.
_snapshots/
cleanup_2026-07*/
log-cleanup*

# === Pipeline data & output roots ===
# Everything below is raw/derived data or regenerated by a pipeline run (see
# CLAUDE.md's output contract) -- none of it should ever need `git add`, and
# config paths point at these directories by absolute path regardless of
# where this checkout lives.
/data/
/results/
/indices/
/logs/
/af_home/
/unorganized/
/backups/

# === Split out to their own repos ===
# labwork/ has been physically relocated (own top-level directories at
# /lustre/backup/.../labwork and /lustre/nobackup/.../labwork) and no longer
# lives under this tree at all -- nothing to ignore. projects/ is still
# nested here pending the same move.
/projects/

# === Large/binary formats that only ever belong in the directories above ===
# A safety net for a stray file landing outside them, not a substitute for
# the directory rules -- do not rely on this list alone.
*.h5
*.h5ad
*.loom
*.rds
*.rdata
*.bam
*.bai
*.sam
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.idx
*.done

# === Run artifacts that can land at the repo root ===
*.log
slurm-*.out
slurm-*.err
