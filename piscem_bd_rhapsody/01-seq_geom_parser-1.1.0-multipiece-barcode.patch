+/// The sequence extracted for one barcode level.
+///
+/// A level is usually a single contiguous span of the read, but split-barcode
+/// chemistries interleave the blocks of one logical barcode with linker
+/// sequence, so a level can be assembled from several disjoint pieces. The
+/// pieces are held in read order and are concatenated left to right.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct BarcodeSeq<'a> {
+    pieces: SmallVec<[&'a [u8]; MAX_BC_PIECES]>,
+}
+
+impl<'a> BarcodeSeq<'a> {
+    /// Build a level from a single contiguous piece.
+    #[inline]
+    pub fn from_piece(piece: &'a [u8]) -> Self {
+        let mut pieces = SmallVec::new();
+        pieces.push(piece);
+        Self { pieces }
+    }
+
+    /// Append the next piece of this level, in read order.
+    #[inline]
+    pub fn push(&mut self, piece: &'a [u8]) {
+        self.pieces.push(piece);
+    }
+
+    /// True when no piece of this level was extracted.
+    #[inline]
+    pub fn is_empty(&self) -> bool {
+        self.pieces.is_empty() || self.pieces.iter().all(|p| p.is_empty())
+    }
+
+    /// Total width of the assembled barcode, in bases.
+    #[inline]
+    pub fn len(&self) -> usize {
+        self.pieces.iter().map(|p| p.len()).sum()
+    }
+
+    /// The individual pieces, in read order.
+    #[inline]
+    pub fn pieces(&self) -> &[&'a [u8]] {
+        &self.pieces
+    }
+
+    /// The barcode as one borrowed slice, when it is a single contiguous piece.
+    ///
+    /// This is the zero-copy fast path that every single-piece chemistry takes;
+    /// a split barcode returns `None` and must go through [`Self::assemble_into`].
+    #[inline]
+    pub fn as_contiguous(&self) -> Option<&'a [u8]> {
+        match self.pieces.as_slice() {
+            [single] => Some(single),
+            _ => None,
+        }
+    }
+
+    /// Concatenate the pieces into `buf` and return the assembled barcode.
+    ///
+    /// `buf` is caller-owned so it can be reused across reads; this performs no
+    /// allocation once it has grown to the barcode width.
+    pub fn assemble_into<'b>(&self, buf: &'b mut SmallVec<[u8; MAX_BC_TOTAL_LEN]>) -> &'b [u8] {
+        buf.clear();
+        for piece in &self.pieces {
+            buf.extend_from_slice(piece);
+        }
+        buf.as_slice()
+    }
+}
