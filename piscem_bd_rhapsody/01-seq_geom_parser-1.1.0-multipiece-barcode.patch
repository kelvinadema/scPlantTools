+/// Number of distinct barcode levels addressable by the `bN[..]` syntax.
+const NUM_ADDRESSABLE_LEVELS: usize = 10;
+
+/// Validate the barcode levels, including levels assembled from several pieces.
+///
+/// A split-barcode chemistry contributes more than one tag to the same level
+/// (e.g. `b[9]f[GTGA]b[9]f[GACA]b[9]`, one 27bp cell label in three pieces).
+/// The pieces are concatenated in read order, so the constraints apply to the
+/// assembled barcode rather than to any individual piece.
+fn validate_barcode_levels(all_parts: &[&GeoPart]) -> Result<(), String> {
+    let has_sample = all_parts
+        .iter()
+        .any(|p| matches!(p.tag, GeoTagType::SampleBarcode));
+    let has_plain_bc = all_parts
+        .iter()
+        .any(|p| matches!(p.tag, GeoTagType::Barcode));
+    // Mirrors the level assignment the extractor uses: `s` is always level 0,
+    // so a plain `b` alongside it becomes level 1.
+    let plain_bc_level = if has_sample && has_plain_bc { 1u8 } else { 0u8 };
+
+    let mut widths = [0usize; NUM_ADDRESSABLE_LEVELS];
+    let mut piece_counts = [0usize; NUM_ADDRESSABLE_LEVELS];
+    let mut variable_counts = [0usize; NUM_ADDRESSABLE_LEVELS];
+
+    for part in all_parts {
+        let level = match part.tag {
+            GeoTagType::SampleBarcode => 0,
+            GeoTagType::Barcode => plain_bc_level,
+            GeoTagType::NumberedBarcode(n) => n,
+            _ => continue,
+        } as usize;
+        if level >= NUM_ADDRESSABLE_LEVELS {
+            return Err(format!(
+                "barcode level {} exceeds the maximum addressable level {}",
+                level,
+                NUM_ADDRESSABLE_LEVELS - 1
+            ));
+        }
+
+        let width = match part.len {
+            GeoLen::Fixed(n) => n as usize,
+            GeoLen::Range(_, max) => max as usize,
+            GeoLen::Unbounded => {
+                return Err(format!(
+                    "barcode level {} cannot be unbounded; give it a fixed or ranged width",
+                    level
+                ))
+            }
+        };
+
+        widths[level] += width;
+        piece_counts[level] += 1;
+        if matches!(part.len, GeoLen::Range(_, _)) {
+            variable_counts[level] += 1;
+        }
+    }
+
+    for level in 0..NUM_ADDRESSABLE_LEVELS {
+        if piece_counts[level] == 0 {
+            continue;
+        }
+        if piece_counts[level] > MAX_BC_PIECES {
+            return Err(format!(
+                "barcode level {} is split across {} pieces, but at most {} are supported",
+                level, piece_counts[level], MAX_BC_PIECES
+            ));
+        }
+        if widths[level] > MAX_BC_TOTAL_LEN {
+            return Err(format!(
+                "barcode level {} totals {} bases, but at most {} are supported",
+                level, widths[level], MAX_BC_TOTAL_LEN
+            ));
+        }
+        // Padding a variable-length barcode encodes the captured length in a
+        // suffix, which is only invertible when one piece can vary.
+        if variable_counts[level] > 1 {
+            return Err(format!(
+                "barcode level {} has {} variable-length pieces, but at most one is supported",
+                level, variable_counts[level]
+            ));
+        }
+    }
+
+    Ok(())
+}
