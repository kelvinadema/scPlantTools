 /// Maximum number of barcode levels that can be stored inline (no heap allocation).
 pub const MAX_INLINE_BARCODES: usize = 4;
 
+/// Maximum number of physically separate pieces a single barcode level may be
+/// split across.
+///
+/// Split-barcode chemistries interleave the blocks of one logical barcode with
+/// linker sequence, e.g. BD Rhapsody Enhanced Bead V2:
+/// `b[9]f[GTGA]b[9]f[GACA]b[9]`, which is three pieces of one 27bp cell label.
+pub const MAX_BC_PIECES: usize = 4;
+
+/// Maximum total width, in bases, of a single barcode level.
+///
+/// Downstream consumers pack a barcode into a `u64` at 2 bits per base, so a
+/// level wider than this cannot be represented.
+pub const MAX_BC_TOTAL_LEN: usize = 32;
