+    /// BD Rhapsody Enhanced Bead V2: one 27bp cell label carried in three 9bp
+    /// blocks separated by fixed linkers, behind a 0-3bp diversity offset.
+    const BD_RHAPSODY_V2: &str = "1{x[0-3]b[9]f[GTGA]b[9]f[GACA]b[9]u[8]}2{r:}";
+
+    fn bd_read1(offset: &[u8], cls1: &[u8], cls2: &[u8], cls3: &[u8], umi: &[u8]) -> Vec<u8> {
+        let mut r1 = Vec::new();
+        r1.extend_from_slice(offset);
+        r1.extend_from_slice(cls1);
+        r1.extend_from_slice(b"GTGA");
+        r1.extend_from_slice(cls2);
+        r1.extend_from_slice(b"GACA");
+        r1.extend_from_slice(cls3);
+        r1.extend_from_slice(umi);
+        r1
+    }
+
+    #[test]
+    fn split_barcode_declares_summed_width() {
+        let geom = parse_geometry(BD_RHAPSODY_V2).unwrap();
+        crate::validate_geometry(&geom).unwrap();
+        let compiled = CompiledGeom::from_fragment_geom(&geom).unwrap();
+        assert_eq!(compiled.meta().num_bc_levels, 1);
+        assert_eq!(compiled.meta().bc_lens.as_slice(), &[27]);
+        assert_eq!(compiled.meta().umi_len, 8);
+    }
+
+    #[test]
+    fn split_barcode_concatenates_pieces_in_read_order() {
+        let geom = parse_geometry(BD_RHAPSODY_V2).unwrap();
+        let compiled = CompiledGeom::from_fragment_geom(&geom).unwrap();
+        let r2 = b"BIOREAD";
+
+        // Every legal diversity-offset width must yield the same cell label.
+        for offset in [b"".as_slice(), b"G", b"GG", b"GGT"] {
+            let r1 = bd_read1(offset, b"AAAAAAAAA", b"CCCCCCCCC", b"TTTTTTTTT", b"GGGGTTTT");
+            let seqs = compiled.extract(&r1, r2);
+            let bc = &seqs.barcodes[0];
+            assert_eq!(bc.pieces().len(), 3);
+            assert_eq!(bc.len(), 27);
+            assert!(bc.as_contiguous().is_none());
+
+            let mut buf = SmallVec::new();
+            assert_eq!(bc.assemble_into(&mut buf), b"AAAAAAAAACCCCCCCCCTTTTTTTTT");
+            assert_eq!(seqs.umi, Some(b"GGGGTTTT".as_slice()));
+        }
+    }
+
+    #[test]
+    fn split_barcode_keeps_cells_distinct_across_every_block() {
+        let geom = parse_geometry(BD_RHAPSODY_V2).unwrap();
+        let compiled = CompiledGeom::from_fragment_geom(&geom).unwrap();
+        let r2 = b"BIOREAD";
+
+        let assemble = |r1: &[u8]| {
+            let seqs = compiled.extract(r1, r2);
+            let mut buf = SmallVec::new();
+            seqs.barcodes[0].assemble_into(&mut buf).to_vec()
+        };
+
+        let base = assemble(&bd_read1(
+            b"GG",
+            b"AAAAAAAAA",
+            b"CCCCCCCCC",
+            b"TTTTTTTTT",
+            b"GGGGTTTT",
+        ));
+        // A change in any block must change the assembled barcode. Before
+        // pieces were concatenated only the last block survived, so cells
+        // differing in block 1 or 2 silently collapsed into one barcode.
+        let vary_first = assemble(&bd_read1(
+            b"GG",
+            b"GGGGGGGGG",
+            b"CCCCCCCCC",
+            b"TTTTTTTTT",
+            b"GGGGTTTT",
+        ));
+        let vary_second = assemble(&bd_read1(
+            b"GG",
+            b"AAAAAAAAA",
+            b"GGGGGGGGG",
+            b"TTTTTTTTT",
+            b"GGGGTTTT",
+        ));
+        assert_ne!(base, vary_first);
+        assert_ne!(base, vary_second);
+        assert_ne!(vary_first, vary_second);
+    }
+
+    #[test]
+    fn single_piece_barcode_stays_zero_copy() {
+        let geom = parse_geometry("1{b[16]u[12]x:}2{r:}").unwrap();
+        let compiled = CompiledGeom::from_fragment_geom(&geom).unwrap();
+        let r1 = b"ACGTACGTACGTACGTAAAAAAAAAAAAtail";
+        let seqs = compiled.extract(r1, b"BIOREAD");
+        let contiguous = seqs.barcodes[0].as_contiguous().expect("one piece");
+        assert_eq!(contiguous, b"ACGTACGTACGTACGT");
+        // Borrowed straight out of the read rather than copied.
+        assert_eq!(contiguous.as_ptr(), r1.as_ptr());
+    }
 }
